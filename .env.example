# Copie para api/.env e preencha. NUNCA commite o .env.

# Modo demo: habilita personas de teste e o endpoint de inspeção. SOMENTE localhost.
DOCRISK_DEMO_MODE=1

# Pasta de dados (banco SQLite, uploads, páginas renderizadas)
DOCRISK_DATA_DIR=./data

# Provedor de leitura de páginas: gemini | textlayer | tesseract
AI_PROVIDER=gemini

# Google AI Studio (https://aistudio.google.com) — chave gratuita
GEMINI_API_KEY=
# Confira os modelos da sua conta: python -m docrisk_core.ai.poc_gemini --modelos
# gemini-2.5-flash aparece na lista mas respondeu 404 em 05/11/2026; gemini-3.5-flash funcionou (~10 s/página).
GEMINI_MODEL=gemini-3.5-flash
# Requisições por minuto (ajuste ao limite atual do plano gratuito)
GEMINI_RPM=8

# Limiar para enviar à revisão humana e para considerar página ilegível
LIMIAR_CONFIANCA=0.75
LIMIAR_LEGIBILIDADE=0.5

# Uploads
MAX_UPLOAD_MB=50
MAX_PAGINAS=300

# Origens do navegador autorizadas a chamar a API (lista separada por vírgula).
# Só a origem (esquema://host:porta), sem caminho. '*' é recusado. HTTP só em localhost.
# Com DOCRISK_DEMO_MODE=1 apenas origens locais são aceitas (o modo demo expõe tokens de teste).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 1 = processa o lote dentro da requisição (testes/CI). 0 = worker em segundo plano (padrão).
DOCRISK_SYNC=0

# A API recusa uma segunda instância sobre o mesmo DOCRISK_DATA_DIR (fila por processo).
# Desligar (0) só em diagnóstico; nunca com dois processos ativos.
DOCRISK_SINGLE_INSTANCE=1

# Front-end (Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Login Clerk na FastAPI (configuração alternativa à demo acima):
# DOCRISK_AUTH_MODE=clerk
# DOCRISK_DEMO_MODE=0
# CLERK_ISSUER=https://sua-instancia.clerk.accounts.dev
# CLERK_SECRET_KEY=... (segredo da mesma instância, somente no servidor)
# CLERK_AUTHORIZED_PARTIES=https://app.seu-dominio.com
# CLERK_INVITE_REDIRECT_URL=https://app.seu-dominio.com/cadastro
# CLERK_AUDIENCE=... (opcional: usar somente se definido no token Clerk)
# CORS_ORIGINS=https://app.seu-dominio.com
# DOCRISK_DATA_DIR=/volume-persistente/docrisk
