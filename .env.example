# Copie para api/.env e preencha. NUNCA commite o .env.

# Modo demo: habilita personas de teste e o endpoint de inspeção. SOMENTE localhost.
DOCRISK_DEMO_MODE=1

# Pasta de dados (banco SQLite, uploads, páginas renderizadas)
DOCRISK_DATA_DIR=./data

# Provedor de leitura de páginas: gemini | textlayer | tesseract
AI_PROVIDER=gemini

# Google AI Studio (https://aistudio.google.com) — chave gratuita
GEMINI_API_KEY=
# Confira os modelos da sua conta: python -m docrisk_core.ai.poc_gemini --modelos
# gemini-2.5-flash aparece na lista mas respondeu 404 em 05/11/2026; gemini-3.5-flash funcionou (~10 s/página).
GEMINI_MODEL=gemini-3.5-flash
# Requisições por minuto (ajuste ao limite atual do plano gratuito)
GEMINI_RPM=8

# Limiar para enviar à revisão humana e para considerar página ilegível
LIMIAR_CONFIANCA=0.75
LIMIAR_LEGIBILIDADE=0.5

# Uploads
MAX_UPLOAD_MB=50
MAX_PAGINAS=300

# Front-end (Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
