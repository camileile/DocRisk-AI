# URL pública da API de TESTE para o bundle Next.js. Nunca inclua token/chave.
# Válido em desenvolvimento local com a API FastAPI escutando em 127.0.0.1:8000.
NEXT_PUBLIC_DOCRISK_API_URL=http://127.0.0.1:8000

# Modo Clerk: runtime Next.js. Omitir ou usar demo mantém a exportação estática.
# NEXT_PUBLIC_AUTH_MODE=clerk
# NEXT_PUBLIC_API_URL=https://api.seu-dominio.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_... (chave pública da instância escolhida)
# CLERK_SECRET_KEY=... (somente no servidor Next.js; nunca NEXT_PUBLIC_)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastro
