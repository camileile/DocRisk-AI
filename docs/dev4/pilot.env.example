# Piloto privado (D4-06). Modelo SEM SEGREDOS. Copie para o host como api/.env.
# Ver docs/dev4/D4-06_PILOTO_PRIVADO.md: configuração preliminar, sem validação externa.

# Nunca 1 no piloto: o modo demo expõe tokens de teste.
DOCRISK_DEMO_MODE=0

# Volume persistente dedicado (banco, uploads, páginas). Fazer backup com scripts/backup.py.
DOCRISK_DATA_DIR=/srv/docrisk/data

AI_PROVIDER=gemini
# Injetar pelo cofre/serviço do host; não gravar aqui.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_RPM=8

LIMIAR_CONFIANCA=0.75
LIMIAR_LEGIBILIDADE=0.5
MAX_UPLOAD_MB=50
MAX_PAGINAS=300

# Só a origem HTTPS do piloto.
CORS_ORIGINS=https://piloto.example.invalid

DOCRISK_SYNC=0
DOCRISK_SINGLE_INSTANCE=1
DOCRISK_LOG_JSON=1
DOCRISK_LOG_LEVEL=INFO

# Front (build): mesma origem do proxy.
NEXT_PUBLIC_API_URL=https://piloto.example.invalid

# Identidade operacional (PR #46); preencher no host, sem versionar segredos.
DOCRISK_AUTH_MODE=clerk
CLERK_ISSUER=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=https://piloto.example.invalid
CLERK_INVITE_REDIRECT_URL=https://piloto.example.invalid/cadastro
CLERK_AUDIENCE=
# Build do web: configurar também NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY no ambiente.
